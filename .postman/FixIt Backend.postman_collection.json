		{
			"name": "Cliente",
			"item": [
				{
					"name": "Listar Clientes",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const keycloakUrl = 'http://localhost:8085/realms/fixit/protocol/openid-connect/token';",
									"const clientId = 'fixit_backend';",
									"const username = 'user';",
									"const password = '123';",
									"",
									"// ==== FUNÇÃO PRINCIPAL ====",
									"pm.sendRequest({",
									"    url: keycloakUrl,",
									"    method: 'POST',",
									"    header: [",
									"        { key: 'Content-Type', value: 'application/x-www-form-urlencoded' }",
									"    ],",
									"    body: {",
									"        mode: 'urlencoded',",
									"        urlencoded: [",
									"            { key: 'client_id', value: clientId },",
									"            { key: 'grant_type', value: 'password' },",
									"            { key: 'username', value: username },",
									"            { key: 'password', value: password }",
									"        ]",
									"    }",
									"}, function (err, res) {",
									"    if (err) {",
									"        console.error('❌ Erro ao obter token do Keycloak:', err);",
									"    } else {",
									"        if (res.code !== 200) {",
									"            console.error('Erro HTTP ao buscar token:', res.code, res.text);",
									"        } else {",
									"            const json = res.json();",
									"            const token = json.access_token;",
									"",
									"            if (token) {",
									"                // Armazena o token como variável de ambiente",
									"                pm.environment.set('access_token', token);",
									"                pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
									"                console.log('Token armazenado com sucesso!');",
									"            } else {",
									"                console.error('Token não encontrado na resposta:', json);",
									"            }",
									"        }",
									"    }",
									"});",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}",
								"type": "text"
							}
