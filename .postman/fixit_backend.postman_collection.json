		{
			"name": "Security Endpoint",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							" const keycloakUrl = 'http://localhost:8085/realms/fixit/protocol/openid-connect/token';",
							"const clientId = 'fixit_backend';",
							"const username = 'user';",
							"const password = '123';",
							"",
							"// Busca o token do Keycloak antes de fazer a requisição principal",
							"pm.sendRequest({",
							"    url: keycloakUrl,",
							"    method: 'POST',",
							"    header: {",
							"        'Content-Type': 'application/x-www-form-urlencoded'",
							"    },",
							"    body: {",
							"        mode: 'urlencoded',",
							"        urlencoded: [",
							"            { key: 'client_id', value: clientId },",
							"            { key: 'grant_type', value: 'password' },",
							"            { key: 'username', value: username },",
							"            { key: 'password', value: password }",
							"        ]",
							"    }",
							"}, function (err, res) {",
							"    if (err) {",
							"        console.error('❌ Erro ao obter token do Keycloak:', err);",
							"        return;",
							"    }",
							"    ",
							"    if (res.code !== 200) {",
							"        console.error('⚠️ Erro HTTP ao buscar token:', res.code, res.text());",
							"        return;",
							"    }",
							"    ",
							"    const json = res.json();",
							"    const token = json.access_token;",
							"",
							"    if (token) {",
							"        // Armazena o token como variável de ambiente",
							"        pm.environment.set('access_token', token);",
							"        console.log('✅ Token armazenado com sucesso!');",
							"    } else {",
							"        console.error('❌ Token não encontrado na resposta:', json);",
							"    }",
							"});",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
